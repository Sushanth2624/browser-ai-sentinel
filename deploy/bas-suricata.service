[Unit]
Description=Browser AI Sentinel - Suricata sensor (JA3/JA4 fingerprinting on ens18)
Documentation=https://github.com/Sushanth2624/browser-ai-sentinel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /home/analysis/browser-ai-sentinel/sensor/logs/suricata
# No -i flag here: that would override the config's af-packet list (which watches BOTH ens18
# and lo — see suricata.yaml's comment) down to a single interface. Confirmed empirically: with
# -i ens18 present, lo-only traffic (the mock-ai endpoints) never appeared in eve.json at all.
ExecStart=/usr/bin/suricata -c /home/analysis/browser-ai-sentinel/sensor/suricata/suricata.yaml --af-packet
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
